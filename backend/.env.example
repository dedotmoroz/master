NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Set to 1 only when the API is behind one trusted reverse proxy.
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://naitimastera:naitimastera_test@127.0.0.1:55432/naitimastera_test
VERIFICATION_TOKEN_SECRET=replace-with-at-least-32-random-bytes
PUBLIC_WEB_URL=http://127.0.0.1:4178
RUN_MIGRATIONS_ON_START=true

OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20

# Passwordless registration and login.
AUTH_LINK_TTL_SECONDS=900
AUTH_RATE_LIMIT_PER_IP=20
AUTH_RATE_LIMIT_PER_EMAIL=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# Local RustFS from docker-compose. For AWS, omit STORAGE_ENDPOINT and set force path style to false.
STORAGE_ENDPOINT=http://127.0.0.1:59000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=naitimastera
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true
STORAGE_UPLOAD_URL_TTL_SECONDS=900
STORAGE_DOWNLOAD_URL_TTL_SECONDS=900

# Async malware scanning. ClamAV is mandatory in production.
MALWARE_SCANNER=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=53310
CLAMAV_TIMEOUT_MS=30000

# Public guest upload protection. Turnstile is mandatory in production.
GUEST_UPLOAD_RATE_LIMIT=10
GUEST_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=900
ATTACHMENT_CLEANUP_INTERVAL_MS=60000
# Physical deletion of unused account uploads: enable explicitly after reviewing retention/backups.
ACCOUNT_ATTACHMENT_CLEANUP_ENABLED=false
ATTACHMENT_CLEANUP_BATCH_SIZE=100
GUEST_ATTACHMENT_RETENTION_SECONDS=86400
# TURNSTILE_SECRET_KEY=
# TURNSTILE_EXPECTED_HOSTNAME=naitimastera.ru

# development prints the confirmation URL locally. Production requires smtp.
MAIL_TRANSPORT=development
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Naiti Mastera <no-reply@example.com>
