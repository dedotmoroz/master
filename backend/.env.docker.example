# Local containers using the EXISTING development database/storage on this Mac.
# Copy to .env.docker; never commit the resulting file.
# Replace host.docker.internal with service DNS names on a remote Docker network.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://naitimastera:naitimastera_local@host.docker.internal:55433/naitimastera
VERIFICATION_TOKEN_SECRET=replace-with-at-least-32-random-bytes
PUBLIC_WEB_URL=http://127.0.0.1:8080
TRUST_PROXY_HOPS=1
RUN_MIGRATIONS_ON_START=false
ACCOUNT_ATTACHMENT_CLEANUP_ENABLED=false
STORAGE_ENDPOINT=http://host.docker.internal:59000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=naitimastera
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true
MALWARE_SCANNER=clamav
CLAMAV_HOST=host.docker.internal
CLAMAV_PORT=53310
MAIL_TRANSPORT=development
# Production: NODE_ENV=production, real SMTP, Turnstile and storage credentials.
# See .env.example and the root README; do not disable production protections.
