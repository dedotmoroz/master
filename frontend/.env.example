# Optional public API URL (embedded at build time). Never put secrets here.
# Default /api/v1 uses same-origin reverse proxy, without CORS.
# NEXT_PUBLIC_API_BASE_URL=https://api.example.ru/api/v1

# Used by npm start preview and npm run dev proxy, never embedded in the browser bundle.
API_PROXY_TARGET=http://127.0.0.1:3000

# Public Cloudflare site key (not a secret), embedded when building.
# Required for guest uploads when backend TURNSTILE_SECRET_KEY is configured.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
