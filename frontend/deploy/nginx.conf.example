# Serve out/ as static files; proxy public catalog + explicitly allowed auth endpoints.
server {
    listen 80;
    server_name localhost;
    root /var/www/naitimastera/out;
    index index.html;
    add_header Referrer-Policy "no-referrer" always;

    # Confirmation links must not enter the web server access log with their token.
    location ^~ /auth/ { access_log off; try_files $uri $uri/ =404; }
    location ~ "^/orders/confirm/?$" { access_log off; try_files $uri $uri/ =404; }
    location ~ "^/api/v1/guest-orders(/confirm)?$" {
        limit_except POST { deny all; }
        client_max_body_size 64k;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        add_header Cache-Control "no-store" always;
    }
    location = /api/v1/customer/orders {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Cookie "";
        proxy_set_header Authorization $http_authorization;
        add_header Cache-Control "no-store" always;
    }
    location = /api/v1/notification-preferences {
        limit_except GET PUT { deny all; }
        client_max_body_size 64k;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Cookie "";
        proxy_set_header Authorization $http_authorization;
        add_header Cache-Control "no-store" always;
    }
    location ~ "^/api/v1/notifications/[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}/read$" {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Cookie "";
        proxy_set_header Authorization $http_authorization;
        add_header Cache-Control "no-store" always;
    }
    location = /api/v1/notifications {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Cookie "";
        proxy_set_header Authorization $http_authorization;
        add_header Cache-Control "no-store" always;
    }
    location ~ "^/api/v1/guest-attachments/(upload-requests|[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}/confirm)$" {
        limit_except POST { deny all; }
        client_max_body_size 64k;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        add_header Cache-Control "no-store" always;
    }
    location ~ "^/api/v1/attachments/[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}/owner-(preview|download)-url$" {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Cookie "";
        proxy_set_header Authorization $http_authorization;
        add_header Cache-Control "no-store" always;
    }
    location ~ "^/api/v1/customer/orders/[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}/cancel$" {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Cookie "";
        proxy_set_header Authorization $http_authorization;
        add_header Cache-Control "no-store" always;
    }
    location ~ "^/api/v1/customer/orders/[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$" {
        limit_except GET PUT { deny all; }
        client_max_body_size 64k;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Cookie "";
        proxy_set_header Authorization $http_authorization;
        add_header Cache-Control "no-store" always;
    }

    location ~ "^/api/v1/(orders/[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}/bids|contractor/bids/[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}/withdraw|customer/orders/[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}/bids/[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}/select)$" {
        limit_except POST { deny all; }
        client_max_body_size 64k;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Cookie "";
        proxy_set_header Authorization $http_authorization;
        add_header Cache-Control "no-store" always;
    }
    location ~ "^/api/v1/(contractor/bids|customer/orders/[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}/bids)$" {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Cookie "";
        proxy_set_header Authorization $http_authorization;
        add_header Cache-Control "no-store" always;
    }

    location ~ "^/api/v1/bids/[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}/messages$" {
        limit_except GET POST { deny all; }
        client_max_body_size 64k;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Cookie "";
        proxy_set_header Authorization $http_authorization;
        add_header Cache-Control "no-store" always;
    }

    location ~ "^/api/v1/auth/(email-change|account-deletion)-requests$" {
        limit_except POST { deny all; }
        client_max_body_size 4k;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Cookie "";
        proxy_set_header Authorization $http_authorization;
        add_header Cache-Control "no-store" always;
    }
    location ~ "^/api/v1/auth/((registrations|login-requests)(/confirm)?|(email-change|account-deletion)-requests/confirm)$" {
        limit_except POST { deny all; }
        client_max_body_size 4k;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        add_header Cache-Control "no-store" always;
        add_header Referrer-Policy "no-referrer" always;
    }
    location = /api/v1/auth/me {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Cookie "";
        proxy_set_header Authorization $http_authorization;
        add_header Cache-Control "no-store" always;
    }
    location ~ "^/api/v1/auth/sessions?$" {
        limit_except DELETE { deny all; }
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Cookie "";
        proxy_set_header Authorization $http_authorization;
        add_header Cache-Control "no-store" always;
    }

    location ~ "^/api/v1/((orders|contractors)(/[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12})?|work-categories|regions|locations)$" {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_set_header Host $host;
        add_header Cache-Control "no-store" always;
    }
    location ~ "^/api/v1/orders/[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}/deal$" {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Cookie "";
        proxy_set_header Authorization $http_authorization;
        add_header Cache-Control "no-store" always;
    }
    location ~ "^/api/v1/orders/[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}/(complete|reviews)$" {
        limit_except POST { deny all; }
        client_max_body_size 64k;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Cookie "";
        proxy_set_header Authorization $http_authorization;
        add_header Cache-Control "no-store" always;
    }
    location ~ "^/api/v1/contractors/[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}/reviews$" {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        add_header Cache-Control "no-store" always;
    }
    location = /api/v1/contractor/profile {
        limit_except GET PUT { deny all; }
        client_max_body_size 512k;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Cookie "";
        proxy_set_header Authorization $http_authorization;
        add_header Cache-Control "no-store" always;
    }
    location = /api/v1/attachments/upload-requests {
        limit_except POST { deny all; }
        client_max_body_size 64k;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Cookie "";
        proxy_set_header Authorization $http_authorization;
        add_header Cache-Control "no-store" always;
    }
    location ~ "^/api/v1/attachments/[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}/confirm$" {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Cookie "";
        proxy_set_header Authorization $http_authorization;
        add_header Cache-Control "no-store" always;
    }
    location ~ "^/api/v1/attachments/[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}/(preview-url|download-url)$" {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        add_header Cache-Control "no-store" always;
    }
    location /api/ { return 404; }
    location / { try_files $uri $uri/ =404; }
    error_page 404 /404.html;
    location = /404.html { internal; }
}
